# Backend Environment Configuration
# Active AI Provider: "gemini" (production cloud AI) or "ollama" (local development)
AI_PROVIDER=gemini

# Google Gemini API Settings (Official google-genai SDK)
# Supported models: gemini-3.5-flash-lite (fastest, high throughput), gemini-3.8-flash, gemini-3.1-pro-preview
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama Local Fallback Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# Optional Backend Cloud Sync (Supabase)
# For least-privilege operations respecting RLS, use SUPABASE_PUBLISHABLE_KEY.
# Secret / Service Role Key is ONLY needed if backend performs unconstrained admin maintenance.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

FRONTEND_URL=https://your-civiclens-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
MAX_UPLOAD_SIZE_MB=10
AI_REQUEST_TIMEOUT_SECONDS=45.0

# Demo Mode & Safety Barrier (Simulated Civic Management)
# When DEMO_MODE=true, external emails, SMS, webhooks, and real government APIs are strictly blocked.
DEMO_MODE=true
DEMO_ALLOW_EXTERNAL_SUBMISSIONS=false
DEMO_CITIZEN_TOKEN=civiclens-demo-citizen-token-2026
DEMO_ADMIN_TOKEN=civiclens-demo-admin-token-2026
DEMO_DATA_FILE=data/demo_complaints.json
