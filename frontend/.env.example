# Frontend Environment Configuration
# Local development points to FastAPI at http://localhost:8000
VITE_API_URL=http://localhost:8000

# Supabase Public Configuration (Optional - LocalStorage active as fallback)
# Use ONLY your Project URL and Publishable Key (or Anon Key) here.
# NEVER place your secret or service_role key in frontend environment files!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
